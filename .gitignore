# Environments and caches
.venv/
.cache/
__pycache__/
*.pyc

# Large generated or downloaded content (indexed in artifacts/README.md, data/README.md)
data/*
!data/README.md
artifacts/*
!artifacts/README.md
# the talk's deck is kept with its script (docs/presentation/talk-track.md); the rest of presentation/ stays local
!artifacts/presentation/
artifacts/presentation/*
!artifacts/presentation/ghostmap-talk.pptx
dist/assets/*
!dist/assets/ghostmap/
third_party/

# Credentials (never committed)
.secrets/

# unprivileged CUDA toolchain (micromamba prefix; see README setup)
.cuda/
